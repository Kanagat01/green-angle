# Шаблон настроек для docker-compose.prod.yml. Скопируйте в .env.prod и заполните.
# .env.prod в git не попадает.

# Домены, на которые выпускаются HTTPS-сертификаты (DNS A-записи обоих должны указывать на сервер):
# DOMAIN — API, файлы и Socket.IO; APP_DOMAIN — сайт и личные кабинеты (его же укажите в APP_URL и CORS_ORIGINS ниже)
DOMAIN=api.example.com
APP_DOMAIN=app.example.com

# Пароль Postgres. Только буквы и цифры (он подставляется в строку подключения):
#   openssl rand -hex 24
POSTGRES_PASSWORD=

# Секреты JWT — разные, не короче 16 символов:
#   openssl rand -base64 48
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=

# Секрет подписи ссылок на файлы (драйвер disk), не короче 16 символов:
#   openssl rand -base64 48
FILES_SIGNING_SECRET=

# Где лежат файлы: disk — на диске сервера (том uploads, входит в резервную копию), s3 — во внешнем хранилище
STORAGE_DRIVER=disk

# Только для STORAGE_DRIVER=s3 (Yandex Object Storage / Selectel; бакет создайте заранее)
S3_ENDPOINT=
# Адрес в presigned URL для браузера; пусто — равен S3_ENDPOINT
S3_PUBLIC_ENDPOINT=
S3_REGION=ru-central1
S3_BUCKET=
S3_ACCESS_KEY=
S3_SECRET_KEY=

# Исходящая почта (подтверждение email, уведомления). Ящик компании: сервер, логин и пароль
SMTP_HOST=smtp.example.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=
SMTP_PASS=
MAIL_FROM=Green Angle <noreply@example.com>
# Адрес фронтенда для ссылок в письмах (без слэша в конце)
APP_URL=https://app.example.com

# Push-уведомления (Web Push). Ключи свои для боевого сервера, не копируйте из разработки:
#   cd backend && pnpm exec web-push generate-vapid-keys
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
# mailto:адрес или https-адрес сайта
VAPID_SUBJECT=mailto:admin@example.com

# Адреса фронтенда через запятую (без пути и слэша в конце). Пусто — кросс-доменные запросы запрещены
CORS_ORIGINS=https://app.example.com

# Необязательно
LOG_LEVEL=info
# Через сколько минут сообщение клиента без ответа повторно уходит всем сотрудникам
PUSH_FALLBACK_MINUTES=60
SWAGGER_ENABLED=false
BACKUP_KEEP_DAYS=14
BACKUP_INTERVAL_SEC=86400
# Копировать ли каталог с файлами вместе с базой (при STORAGE_DRIVER=s3 не нужно)
BACKUP_UPLOADS=true
