# Шаблон настроек для docker-compose.prod.yml. Скопируйте в .env.prod и заполните.
# .env.prod в git не попадает.

# Домен, на который выпускается HTTPS-сертификат (DNS A-запись должна указывать на сервер)
DOMAIN=api.example.com

# Пароль Postgres. Только буквы и цифры (он подставляется в строку подключения):
#   openssl rand -hex 24
POSTGRES_PASSWORD=

# Секреты JWT — разные, не короче 16 символов:
#   openssl rand -base64 48
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=

# Секрет подписи ссылок на файлы (драйвер disk), не короче 16 символов:
#   openssl rand -base64 48
FILES_SIGNING_SECRET=

# Где лежат файлы: disk — на диске сервера (том uploads, входит в резервную копию), s3 — во внешнем хранилище
STORAGE_DRIVER=disk

# Только для STORAGE_DRIVER=s3 (Yandex Object Storage / Selectel; бакет создайте заранее)
S3_ENDPOINT=
# Адрес в presigned URL для браузера; пусто — равен S3_ENDPOINT
S3_PUBLIC_ENDPOINT=
S3_REGION=ru-central1
S3_BUCKET=
S3_ACCESS_KEY=
S3_SECRET_KEY=

# Адреса фронтенда через запятую (без пути и слэша в конце). Пусто — кросс-доменные запросы запрещены
CORS_ORIGINS=https://app.example.com

# Необязательно
LOG_LEVEL=info
SWAGGER_ENABLED=false
BACKUP_KEEP_DAYS=14
BACKUP_INTERVAL_SEC=86400
# Копировать ли каталог с файлами вместе с базой (при STORAGE_DRIVER=s3 не нужно)
BACKUP_UPLOADS=true
