// Domain model: see PLAN.md §3

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  ADMIN
  BROKER
  INDIVIDUAL
}

enum ClientType {
  COMPANY
  PERSON
}

enum AttachmentKind {
  PHOTO
  VIDEO
  FILE
  AUDIO
}

enum RequestStatus {
  NEW
  IN_DIALOG
  APPROVED
  REJECTED
}

enum MessageType {
  TEXT
  VOICE
  // служебная строка в диалоге (одобрение, отклонение, смена статуса машины); без автора
  SYSTEM
}

model Client {
  id        String     @id @default(uuid()) @db.Uuid
  type      ClientType
  name      String
  // ИНН компании (10 или 12 цифр); у физлица не заполняется
  inn       String?
  // телефон из регистрации: только хранится, не подтверждается и для входа не используется
  phone     String?
  // когда дано согласие на обработку персональных данных (при регистрации)
  consentAt DateTime?
  createdAt DateTime   @default(now())

  users    User[]
  vehicles Vehicle[]
  requests Request[]
}

model User {
  id                 String    @id @default(uuid()) @db.Uuid
  email              String    @unique
  passwordHash       String
  role               Role
  // null только у ADMIN
  clientId           String?   @db.Uuid
  isActive           Boolean   @default(true)
  createdAt          DateTime  @default(now())
  // null — почта не подтверждена, войти нельзя. Аккаунты, созданные менеджером, подтверждены сразу
  emailVerifiedAt    DateTime?
  // письма о смене статуса машины; по умолчанию включены (для физлица), у подборщика не используется
  emailNotifications Boolean   @default(true)

  client Client? @relation(fields: [clientId], references: [id])

  uploadedAttachments Attachment[]
  authoredMessages    Message[]
  messageReads        MessageRead[]
  createdRequests     Request[]
  statusChanges       VehicleStatusLog[]
  refreshTokens       RefreshToken[]
  pushSubscriptions   PushSubscription[]
  assignedRequests    Request[]          @relation("RequestAssignee")
  emailTokens         EmailToken[]

  @@index([clientId])
}

// Браузерная подписка на push (Web Push): одно устройство — одна запись
model PushSubscription {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String   @db.Uuid
  // адрес пушевого сервиса браузера; по нему подписка уникальна
  endpoint  String   @unique
  p256dh    String
  auth      String
  userAgent String?
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

// Одноразовые ссылки подтверждения email; в БД хранится только хеш токена
model EmailToken {
  id        String    @id @default(uuid()) @db.Uuid
  userId    String    @db.Uuid
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

// Refresh-токены с ротацией: id записи = jti токена, family связывает цепочку ротаций
model RefreshToken {
  id        String    @id @default(uuid()) @db.Uuid
  userId    String    @db.Uuid
  familyId  String    @db.Uuid
  expiresAt DateTime
  revokedAt DateTime?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([familyId])
}

model Vehicle {
  id            String   @id @default(uuid()) @db.Uuid
  clientId      String   @db.Uuid
  // «Geely Monjaro, 2024»
  title         String
  // nullable: машина из одобренной заявки создаётся без VIN. Postgres допускает много NULL в unique-индексе
  vin           String?  @unique
  // 1..13, диапазон проверяется CHECK-ограничением в миграции
  currentStep   Int      @default(1)
  createdAt     DateTime @default(now())
  // «Обновлено» в карточке: смена статуса, правка названия и VIN
  updatedAt     DateTime @default(now()) @updatedAt
  // Уведомления конечному клиенту подборщика (он не пользователь системы): email и включено ли.
  // Для машин физлица не используются — письма идут на email самого физлица
  notifyEmail   String?
  notifyEnabled Boolean  @default(false)

  client     Client             @relation(fields: [clientId], references: [id])
  steps      VehicleStep[]
  statusLogs VehicleStatusLog[]
  request    Request?

  @@index([clientId])
  @@index([currentStep])
}

// Состояние шагов машины (завершён / нет)
model VehicleStep {
  id                String    @id @default(uuid()) @db.Uuid
  vehicleId         String    @db.Uuid
  step              Int
  completedAt       DateTime?
  declarationNumber String?

  vehicle     Vehicle      @relation(fields: [vehicleId], references: [id], onDelete: Cascade)
  attachments Attachment[]

  @@unique([vehicleId, step])
}

// Журнал смен статуса: append-only, наружу не отдаётся (PLAN.md §4)
model VehicleStatusLog {
  id                String   @id @default(uuid()) @db.Uuid
  vehicleId         String   @db.Uuid
  // null при создании машины
  fromStep          Int?
  toStep            Int
  declarationNumber String?
  changedById       String   @db.Uuid
  changedAt         DateTime @default(now())

  vehicle   Vehicle @relation(fields: [vehicleId], references: [id])
  changedBy User    @relation(fields: [changedById], references: [id])

  @@index([vehicleId, changedAt])
  @@index([changedById])
}

model Attachment {
  id            String         @id @default(uuid()) @db.Uuid
  // ключ объекта в S3
  key           String         @unique
  mime          String
  size          Int
  kind          AttachmentKind
  uploadedById  String         @db.Uuid
  vehicleStepId String?        @db.Uuid
  messageId     String?        @db.Uuid
  createdAt     DateTime       @default(now())

  uploadedBy       User         @relation(fields: [uploadedById], references: [id])
  vehicleStep      VehicleStep? @relation(fields: [vehicleStepId], references: [id], onDelete: Cascade)
  message          Message?     @relation(fields: [messageId], references: [id], onDelete: Cascade)
  // сообщения диалога, в которых показано это вложение шага (комментарий при смене статуса);
  // удаление сообщения не удаляет вложение шага
  sharedInMessages Message[]    @relation("MessageSharedAttachments")

  @@index([vehicleStepId])
  @@index([messageId])
  @@index([uploadedById])
}

model Request {
  id            String        @id @default(uuid()) @db.Uuid
  clientId      String        @db.Uuid
  createdById   String        @db.Uuid
  // «Chery Tiggo 8 Pro»
  title         String
  yearFrom      Int?
  budget        Decimal?      @db.Decimal(14, 2)
  comment       String?
  status        RequestStatus @default(NEW)
  // проставляется при одобрении
  vehicleId     String?       @unique @db.Uuid
  createdAt     DateTime      @default(now())
  // Производные поля очереди; их ведут триггеры БД (см. миграцию request_activity), не код приложения
  // время последнего сообщения диалога
  lastMessageAt DateTime?
  // «ждёт ответа»: заявка открыта и последнее сообщение написал клиент (не менеджер и не система)
  awaitingReply Boolean       @default(false)
  // ответственный: сотрудник, ответивший в заявке последним; ему идёт push о новых сообщениях клиента
  assigneeId    String?       @db.Uuid
  // когда сообщение клиента без ответа было повторно разослано всем сотрудникам
  escalatedAt   DateTime?

  client    Client    @relation(fields: [clientId], references: [id])
  createdBy User      @relation(fields: [createdById], references: [id])
  assignee  User?     @relation("RequestAssignee", fields: [assigneeId], references: [id], onDelete: SetNull)
  vehicle   Vehicle?  @relation(fields: [vehicleId], references: [id])
  messages  Message[]

  @@index([clientId, status])
  @@index([status, createdAt])
  @@index([awaitingReply, lastMessageAt])
}

model Message {
  id          String      @id @default(uuid()) @db.Uuid
  requestId   String      @db.Uuid
  // null только у SYSTEM (CHECK-ограничение в миграции)
  authorId    String?     @db.Uuid
  type        MessageType @default(TEXT)
  text        String?
  // только для VOICE
  durationSec Int?
  // ссылки на объявления
  links       String[]    @default([])
  createdAt   DateTime    @default(now())

  request           Request       @relation(fields: [requestId], references: [id], onDelete: Cascade)
  author            User?         @relation(fields: [authorId], references: [id], onDelete: Restrict)
  attachments       Attachment[]
  // вложения шагов машины, показанные в этом сообщении (комментарий менеджера при смене статуса)
  sharedAttachments Attachment[]  @relation("MessageSharedAttachments")
  reads             MessageRead[]

  @@index([requestId, createdAt])
  @@index([authorId])
}

model MessageRead {
  messageId String   @db.Uuid
  userId    String   @db.Uuid
  readAt    DateTime @default(now())

  message Message @relation(fields: [messageId], references: [id], onDelete: Cascade)
  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([messageId, userId])
  @@index([userId])
}
