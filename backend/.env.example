NODE_ENV=development
PORT=3000
# fatal | error | warn | info | debug | trace
LOG_LEVEL=info
# true — API за обратным прокси (Caddy/nginx): IP клиента берётся из X-Forwarded-For
TRUST_PROXY=false
# Swagger на /api/docs; по умолчанию включён везде, кроме NODE_ENV=production
# SWAGGER_ENABLED=true

DATABASE_URL=postgresql://green:green@localhost:5432/green_angle?schema=public

# Секреты разные и не короче 16 символов; в production значения change-me* запрещены
JWT_ACCESS_SECRET=change-me-access-secret-min-16
JWT_REFRESH_SECRET=change-me-refresh-secret-min-16
JWT_ACCESS_TTL_SEC=900
JWT_REFRESH_TTL_SEC=2592000

S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_BUCKET=green-angle
S3_ACCESS_KEY=minio
S3_SECRET_KEY=minio12345
# Адрес S3 для браузера в presigned URL (если отличается от S3_ENDPOINT, например в Docker)
# S3_PUBLIC_ENDPOINT=http://localhost:9000
S3_PRESIGN_PUT_TTL_SEC=900
S3_PRESIGN_GET_TTL_SEC=3600

STRICT_ATTACHMENTS=false

# Разрешённые Origin для CORS и Socket.IO через запятую (без пути и слэша в конце).
# Пусто — кросс-доменные запросы браузера запрещены.
CORS_ORIGINS=http://localhost:3001

# Ограничение частоты запросов (счётчики в памяти процесса)
RATE_LIMIT_WINDOW_SEC=60
RATE_LIMIT_MAX=600
RATE_LIMIT_LOGIN_WINDOW_SEC=60
RATE_LIMIT_LOGIN_ACCOUNT_MAX=5
RATE_LIMIT_LOGIN_IP_MAX=30
