NODE_ENV=development
PORT=3000
# fatal | error | warn | info | debug | trace
LOG_LEVEL=info
# true — API за обратным прокси (Caddy/nginx): IP клиента берётся из X-Forwarded-For
TRUST_PROXY=false
# Swagger на /api/docs; по умолчанию включён везде, кроме NODE_ENV=production
# SWAGGER_ENABLED=true

DATABASE_URL=postgresql://green:green@localhost:5432/green_angle?schema=public

# Секреты разные и не короче 16 символов; в production значения change-me* запрещены
JWT_ACCESS_SECRET=change-me-access-secret-min-16
JWT_REFRESH_SECRET=change-me-refresh-secret-min-16
JWT_ACCESS_TTL_SEC=900
JWT_REFRESH_TTL_SEC=2592000

# Где лежат файлы: disk — на диске сервера (по умолчанию), s3 — S3-совместимое хранилище.
# API для клиентов одинаковый: выдаётся подписанная ссылка на загрузку (PUT) и скачивание (GET).
STORAGE_DRIVER=disk
# Срок жизни ссылок на загрузку и скачивание, секунды
UPLOAD_URL_TTL_SEC=900
DOWNLOAD_URL_TTL_SEC=3600

# --- STORAGE_DRIVER=disk ---
# Каталог с файлами (в Docker это том; его нужно бэкапить вместе с базой)
UPLOAD_DIR=./data/uploads
# Секрет подписи ссылок, не короче 16 символов; в production значения change-me* запрещены
FILES_SIGNING_SECRET=change-me-files-secret-min-16
# Адрес API, который видит браузер, для ссылок на файлы. Пусто — относительные ссылки («/api/v1/files/…»).
# Фронтенд на другом адресе (localhost:3001) требует абсолютный:
FILES_PUBLIC_URL=http://localhost:3000/api/v1

# --- STORAGE_DRIVER=s3 (MinIO из docker compose --profile s3 или внешний S3) ---
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_BUCKET=green-angle
S3_ACCESS_KEY=minio
S3_SECRET_KEY=minio12345
# Адрес S3 для браузера в presigned URL (если отличается от S3_ENDPOINT, например в Docker)
# S3_PUBLIC_ENDPOINT=http://localhost:9000

STRICT_ATTACHMENTS=false

# Redis для общих счётчиков rate limit между экземплярами API (docker compose up -d redis).
# Пусто — счётчики в памяти процесса (годится для разработки и одного экземпляра).
# В production обязателен. Если Redis недоступен, API временно считает в памяти и продолжает работать.
REDIS_URL=redis://localhost:6379

# Путь к ffprobe: длительность голосовых проверяется по самому файлу (лимит 5 минут тоже по факту).
# Пусто — проверка отключена. В production обязателен; в Docker-образе ffprobe уже установлен.
# Локально: поставьте ffmpeg (https://ffmpeg.org) и укажите путь, например FFPROBE_PATH=ffprobe
FFPROBE_PATH=

# Разрешённые Origin для CORS и Socket.IO через запятую (без пути и слэша в конце).
# Пусто — кросс-доменные запросы браузера запрещены.
CORS_ORIGINS=http://localhost:3001

# Ограничение частоты запросов (счётчики в памяти процесса)
RATE_LIMIT_WINDOW_SEC=60
RATE_LIMIT_MAX=600
RATE_LIMIT_LOGIN_WINDOW_SEC=60
RATE_LIMIT_LOGIN_ACCOUNT_MAX=5
RATE_LIMIT_LOGIN_IP_MAX=30
